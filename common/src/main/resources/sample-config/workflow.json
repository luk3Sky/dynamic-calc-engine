      "ruleIds": ["RULE_OVERTIME_ELIGIBLE", "RULE_ACTIVITY_BONUS_ELIGIBLE"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "BASE_PAY",
      "description": "Compute regular base pay.",
      "engine": "FORMULA",
      "ruleIds": ["RULE_BASE_PAY"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "OVERTIME",
      "description": "Compute overtime premium pay.",
      "engine": "FORMULA",
      "ruleIds": ["RULE_OVERTIME_PAY"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "ACTIVITY_PAY",
      "description": "Compute activity/unit pay.",
      "engine": "FORMULA",
      "ruleIds": ["RULE_ACTIVITY_PAY"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "ALLOWANCES",
      "description": "Compute allowances and their total.",
      "engine": "FORMULA",
      "ruleIds": ["RULE_TRANSPORT_ALLOWANCE", "RULE_MEAL_ALLOWANCE", "RULE_TOTAL_ALLOWANCES"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "GROSS_TOTAL",
      "description": "Compute gross pay now that all earning components exist.",
