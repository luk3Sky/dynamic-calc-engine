      "ruleIds": ["RULE_TAX_SLAB_LOW", "RULE_TAX_SLAB_MID", "RULE_TAX_SLAB_HIGH"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "STATUTORY_DEDUCTIONS",
      "description": "Compute statutory deductions using the classified slab rate.",
      "engine": "FORMULA",
      "ruleIds": ["RULE_INCOME_TAX", "RULE_PROVIDENT_FUND", "RULE_TOTAL_DEDUCTIONS"],
      "execution": "SEQUENTIAL"
    },
    {
      "name": "NET_PAY",
      "description": "Compute final net pay.",
      "engine": "FORMULA",
      "ruleIds": ["RULE_NET_PAY"],
      "execution": "SEQUENTIAL"
    }
  ]
}