### Full-time employee with overtime — expect gross 1375.00, net 1117.50
POST http://localhost:8080/api/v1/payroll/calculate
Content-Type: application/json

{
  "employeeId": "EMP-1001",
  "period": { "startDate": "2026-09-01", "endDate": "2026-09-30" },
  "employee": {
    "grade": 4,
    "employmentType": "FULL_TIME",
    "hourlyRate": 25.00,
    "providentFundRate": 0.12,
    "transportAllowance": 150.00,
    "mealAllowance": 75.00,
    "overtimeMultiplier": 1.5
  },
  "attendance": { "standardHours": 40, "overtimeHours": 4 },
  "activities": [ { "activityType": "DELIVERY", "units": 0, "unitRate": 0 } ]
}

